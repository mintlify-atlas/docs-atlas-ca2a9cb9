  "keyFeatures": [
    "Dual-protocol support: Google DNS-over-HTTPS JSON API and IETF RFC 8484 wire-format",
    "HTTP/2 transport with TLS for encrypted DNS queries",
    "Three upstream load-balancing selectors: random, weighted round-robin, LVS weighted round-robin",
    "EDNS0-Client-Subnet (ECS) support for GeoDNS and CDN compatibility",
    "DNSSEC-compatible with pass-through signature support",
    "DNS-over-TLS upstream support in doh-server (tcp-tls prefix)",
    "Passthrough domains for captive portals and NTP servers",
    "Bootstrap DNS resolvers to avoid circular dependency",
    "Systemd, launchd, and NetworkManager integration",
    "Docker images for both client and server",
    "Mutual TLS client certificate authentication",
    "IPv4 and IPv6 dual-stack support"
  ],
  "publicApiSurface": [
    "doh-client -conf <path> [-verbose] [-version] [-pid-file <path>]",
    "doh-server -conf <path> [-verbose] [-version] [-pid-file <path>]",
    "GET /dns-query?name=<name>&type=<type>[&cd=1&do=1&edns_client_subnet=<ip>/<mask>] (Google JSON protocol)",
    "GET /dns-query?ct=application/dns-message&dns=<base64url> (IETF RFC 8484)",
    "POST /dns-query (Content-Type: application/dns-message) (IETF RFC 8484)",
    "jsondns.Marshal(msg *dns.Msg) *Response",
    "jsondns.Unmarshal(reply *dns.Msg, resp *Response, udpSize uint16, ednsClientNetmask uint8) *dns.Msg",
    "jsondns.PrepareReply(r *dns.Msg) *dns.Msg",
    "config.LoadConfig(path string) (*Config, error)",
    "selector.Selector interface: Get(), StartEvaluate(), ReportUpstreamStatus()"
  ]
}
